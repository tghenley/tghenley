# ------------------------------------------------------------------
# Henley's Studio — Mini Sessions  ·  environment configuration
# Copy this file to ".env.local" and fill in your values.
# ------------------------------------------------------------------

# --- Admin access -------------------------------------------------
# Password for the /admin area. CHANGE THIS before deploying.
ADMIN_PASSWORD=change-me

# Secret used to sign the admin session cookie. Use a long random string.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=please-change-this-to-a-long-random-string

# --- Branding -----------------------------------------------------
NEXT_PUBLIC_STUDIO_NAME=Henley's Studio
NEXT_PUBLIC_STUDIO_TAGLINE=Mini Sessions
# Email shown to clients for questions / where invoices come from.
NEXT_PUBLIC_CONTACT_EMAIL=hello@henleys.studio

# Default currency for new sessions (ISO 4217). e.g. AUD, USD, GBP, NZD.
DEFAULT_CURRENCY=AUD

# --- Storage ------------------------------------------------------
# Path to the SQLite database file. Defaults to ./data/henleys.db
# On a host with a persistent disk, point this at that disk.
DATABASE_PATH=./data/henleys.db

# --- Payments: Square (optional) ----------------------------------
# If these are set, bookings generate a Square hosted payment link so
# clients can pay a deposit/total. Square handles all card security.
# Leave blank to use "send an invoice" mode (e.g. Xero) instead.
# Get these from https://developer.squareup.com (Sandbox or Production).
SQUARE_ACCESS_TOKEN=
SQUARE_LOCATION_ID=
# Use "sandbox" while testing, "production" when live.
SQUARE_ENVIRONMENT=sandbox

# Public base URL of this app (used for Square redirect back after payment).
NEXT_PUBLIC_BASE_URL=http://localhost:3000
